<?xml version="1.0" encoding="UTF-8"?>
<!--
  六轴机械臂 URDF 入口（照搬 OpenArm 的组织方式）

  分层：
      config/  ← 数据（struct / joint / link / inertials / control）
      urdf/    ← 模板（utils 原语 / arm 链 / robot 总装 / ros2_control 接口）

  参数：
      prefix              关节/link 前缀，默认空 → joint1..joint6
      use_fake_hardware   true 用 mock_components（默认），false 用真机插件
      can_interface       SocketCAN 接口名，默认 can0
      can_fd              是否 CANFD，默认 true

  用法：
      xacro hw_arm.urdf.xacro                              # mock + 无前缀
      xacro hw_arm.urdf.xacro use_fake_hardware:=false     # 真机
      xacro hw_arm.urdf.xacro prefix:=left_                # 加前缀
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hw_arm">

  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_fake_hardware" default="true" />
  <xacro:arg name="can_interface" default="can0" />
  <xacro:arg name="can_fd" default="false" />  <!-- 达妙电机只认经典 CAN，不支持 FD -->
  <xacro:arg name="active_joints" default="1,2,3,4,5,6" />
  <xacro:arg name="refresh_per_cycle" default="2" />
  <xacro:arg name="use_gazebo" default="false" />

  <!-- 夹爪（装配体7 平行夹爪，实测 318.5 g）。默认关闭，不影响原有 ROS 接口 -->
  <!-- 重力补偿 / 拖动示教（C-04 / C-05）的开关，默认全关，不改现有行为 -->
  <xacro:arg name="gravity_compensation" default="false" />
  <xacro:arg name="gravity_dry_run" default="true" />
  <xacro:arg name="zero_gravity" default="false" />
  <xacro:arg name="gravity_params_path" default="" />
  <xacro:arg name="gravity_scale" default="1.0" />
  <xacro:arg name="zero_gravity_kd" default="1.0" />
  <xacro:arg name="gravity_ramp_time" default="3.0" />
  <xacro:arg name="gravity_trim" default="0 0 0 0 0 0" />

  <xacro:arg name="with_gripper" default="true" />
  <xacro:arg name="gripper_xyz" default="0 0 0" />
  <!-- 夹爪 +z 是接近方向（指向指尖），与 tool0 的 +z 同向 ⇒ 默认 identity -->
  <xacro:arg name="gripper_rpy" default="0 0 0" />

  <!-- config_root 用 $(arg) 而不是 $(find)，这样**构建期**（包还没安装、
       不在 ament 索引里）也能用 `xacro ... config_root:=<绝对路径>` 覆盖。
       传了 arg 之后，默认值里的 $(find) 不会被求值（已实测验证）。
       → 解决了「全新 clone 之后 colcon build 编译不过」的问题。 -->
  <xacro:arg name="config_root" default="$(find hw_arm_description)/config" />
  <xacro:property name="config_root" value="$(arg config_root)" lazy_eval="false" />
  <xacro:property name="control_gains"
                  value="${xacro.load_yaml(config_root + '/control/control_gains.yaml')}"
                  lazy_eval="false" />

  <xacro:include filename="utils/hw_arm_robot.xacro" />
  <xacro:include filename="utils/hw_arm_gripper.xacro" />
  <xacro:include filename="ros2_control/hw_arm.ros2_control.xacro" />

  <!-- 几何 / 惯性 -->
  <xacro:hw_arm_robot config_root="${config_root}" prefix="$(arg prefix)" />

  <!-- 末端夹爪（可选） -->
  <xacro:if value="$(arg with_gripper)">
    <xacro:hw_arm_gripper
      prefix="$(arg prefix)"
      parent="tool0"
      xyz="$(arg gripper_xyz)"
      rpy="$(arg gripper_rpy)" />
  </xacro:if>

  <!-- 控制接口 -->
  <xacro:hw_arm_ros2_control
    prefix="$(arg prefix)"
    can_interface="$(arg can_interface)"
    can_fd="$(arg can_fd)"
    use_fake_hardware="$(arg use_fake_hardware)"
    active_joints="$(arg active_joints)"
    refresh_per_cycle="$(arg refresh_per_cycle)"
    use_gazebo="$(arg use_gazebo)"
    gravity_compensation="$(arg gravity_compensation)"
    gravity_dry_run="$(arg gravity_dry_run)"
    zero_gravity="$(arg zero_gravity)"
    gravity_params_path="$(arg gravity_params_path)"
    gravity_scale="$(arg gravity_scale)"
    zero_gravity_kd="$(arg zero_gravity_kd)"
    gravity_ramp_time="$(arg gravity_ramp_time)"
    gravity_trim="$(arg gravity_trim)"
    control_gains="${control_gains}" />

</robot>
