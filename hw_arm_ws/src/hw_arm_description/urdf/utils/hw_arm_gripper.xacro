    </link>
    <link name="${prefix}gr_tcp">
      <!-- 视觉暂用碰撞盒代替（gripper_jaw_*.STL 缺失） -->
    </link>
    <joint name="${prefix}gr_joint1" type="fixed">
      <parent link="${prefix}gr_baselink"/>
      <child link="${prefix}gr_link1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}gr_joint2" type="fixed">
      <parent link="${prefix}gr_baselink"/>
      <child link="${prefix}gr_link2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}gr_tcp_joint" type="fixed">
      <parent link="${prefix}gr_baselink"/>
      <child link="${prefix}gr_tcp"/>
      <origin xyz="0 0 0.1000" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
