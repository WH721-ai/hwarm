      </collision>
    </link>
    <link name="${prefix}gr_link2">
      <inertial>
        <origin xyz="0.012523 0.004131 0.065194" rpy="0 0 0"/>
        <mass value="0.024139270"/>
        <inertia ixx="6.315624591e-06" ixy="-7.687056696e-08" ixz="4.788156708e-07" iyy="7.983065745e-06" iyz="4.814927552e-07" izz="4.849729650e-06"/>
