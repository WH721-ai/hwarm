<?xml version="1.0" encoding="UTF-8"?>
<!--
  原语层（照搬 OpenArm 的 urdf/utils/openarm_v20_utils.xacro）

  这是整个描述系统**唯一**真正写 XML 标签的地方：
      hw_emit_origin          →  <origin xyz rpy>
      hw_emit_composed_origin →  两个 origin 相乘（frame_shift 用，当前数据没用到）
      hw_emit_limit           →  <limit>
      hw_emit_visual          →  <visual>（支持 cylinder / mesh 两种 geometry）
      hw_emit_collision       →  <collision>
      hw_emit_inertial        →  <inertial>
      hw_emit_link            →  <link> + 全部 visual/collision + <inertial>
      hw_emit_reference_link  →  空 link + fixed joint（装配参考点 / TCP）
      hw_emit_joint           →  <joint> + origin + axis + limit

  上层（arm / robot）只负责传数据，不碰标签。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 包根路径。
       ⚠️ xacro 的 `${...}` 只替换一轮，替换出来的字符串里若含 `$(find ...)`
       不会被二次求值。所以这里先在 property 里把 $(find) 求出来，
       mesh 路径再用 `${hw_arm_pkg_path}/...` 拼接。 -->
  <!-- 用 package:// 而不是绝对路径！
       ⚠️ 实测：Jazzy 的 resource_retriever 只接受 **URL**（package:// / file:// / http://），
       传裸绝对路径会报 "URL rejected: No host part in the URL"，
       RViz 就会显示 "Could not load resource ... Unable to open file"。 -->
  <xacro:property name="hw_arm_pkg_url" value="package://hw_arm_description"/>

  <!-- ============================================================ origin -->
  <xacro:macro name="hw_emit_origin" params="origin reflect_x:=1 reflect_y:=1 reflect_z:=1 reflect_position:=true">
    <origin
      xyz="${(reflect_x * origin['x']) if reflect_position else origin['x']} ${(reflect_y * origin['y']) if reflect_position else origin['y']} ${(reflect_z * origin['z']) if reflect_position else origin['z']}"
      rpy="${origin['roll']} ${origin['pitch']} ${origin['yaw']}" />
  </xacro:macro>

  <!-- 把两个 origin 合成一个（C = A · B）。xacro 没有矩阵库，因此手写 3×3 展开。
       只算 RPY 提取需要的 7 个元素（c12 / c13 用不到，故意不算）。 -->
  <xacro:macro name="hw_emit_composed_origin" params="first second reflect_x:=1 reflect_y:=1 reflect_z:=1 reflect_position:=true">
    <xacro:property name="a_r" value="${first['roll']}" />
    <xacro:property name="a_p" value="${first['pitch']}" />
    <xacro:property name="a_y" value="${first['yaw']}" />
    <xacro:property name="b_r" value="${second['roll']}" />
    <xacro:property name="b_p" value="${second['pitch']}" />
    <xacro:property name="b_y" value="${second['yaw']}" />

    <xacro:property name="acr" value="${cos(a_r)}" /><xacro:property name="asr" value="${sin(a_r)}" />
    <xacro:property name="acp" value="${cos(a_p)}" /><xacro:property name="asp" value="${sin(a_p)}" />
    <xacro:property name="acy" value="${cos(a_y)}" /><xacro:property name="asy" value="${sin(a_y)}" />
    <xacro:property name="bcr" value="${cos(b_r)}" /><xacro:property name="bsr" value="${sin(b_r)}" />
    <xacro:property name="bcp" value="${cos(b_p)}" /><xacro:property name="bsp" value="${sin(b_p)}" />
    <xacro:property name="bcy" value="${cos(b_y)}" /><xacro:property name="bsy" value="${sin(b_y)}" />

    <!-- A = Rz(yaw)·Ry(pitch)·Rx(roll) -->
    <xacro:property name="a11" value="${acy * acp}" />
    <xacro:property name="a12" value="${acy * asp * asr - asy * acr}" />
    <xacro:property name="a13" value="${acy * asp * acr + asy * asr}" />
    <xacro:property name="a21" value="${asy * acp}" />
    <xacro:property name="a22" value="${asy * asp * asr + acy * acr}" />
    <xacro:property name="a23" value="${asy * asp * acr - acy * asr}" />
    <xacro:property name="a31" value="${-asp}" />
    <xacro:property name="a32" value="${acp * asr}" />
    <xacro:property name="a33" value="${acp * acr}" />

    <xacro:property name="b11" value="${bcy * bcp}" />
    <xacro:property name="b12" value="${bcy * bsp * bsr - bsy * bcr}" />
    <xacro:property name="b13" value="${bcy * bsp * bcr + bsy * bsr}" />
    <xacro:property name="b21" value="${bsy * bcp}" />
    <xacro:property name="b22" value="${bsy * bsp * bsr + bcy * bcr}" />
    <xacro:property name="b23" value="${bsy * bsp * bcr - bcy * bsr}" />
    <xacro:property name="b31" value="${-bsp}" />
    <xacro:property name="b32" value="${bcp * bsr}" />
    <xacro:property name="b33" value="${bcp * bcr}" />

    <!-- C = A · B（只算 RPY 提取用得到的 7 个元素） -->
    <xacro:property name="c11" value="${a11 * b11 + a12 * b21 + a13 * b31}" />
    <xacro:property name="c21" value="${a21 * b11 + a22 * b21 + a23 * b31}" />
    <xacro:property name="c22" value="${a21 * b12 + a22 * b22 + a23 * b32}" />
    <xacro:property name="c23" value="${a21 * b13 + a22 * b23 + a23 * b33}" />
    <xacro:property name="c31" value="${a31 * b11 + a32 * b21 + a33 * b31}" />
    <xacro:property name="c32" value="${a31 * b12 + a32 * b22 + a33 * b32}" />
    <xacro:property name="c33" value="${a31 * b13 + a32 * b23 + a33 * b33}" />

    <xacro:property name="tx" value="${first['x'] + a11 * second['x'] + a12 * second['y'] + a13 * second['z']}" />
    <xacro:property name="ty" value="${first['y'] + a21 * second['x'] + a22 * second['y'] + a23 * second['z']}" />
    <xacro:property name="tz" value="${first['z'] + a31 * second['x'] + a32 * second['y'] + a33 * second['z']}" />

    <xacro:property name="cy_norm" value="${sqrt(c11 * c11 + c21 * c21)}" />
    <xacro:property name="rr" value="${atan2(c32, c33) if cy_norm > 1e-9 else atan2(-c23, c22)}" />
    <xacro:property name="rp" value="${atan2(-c31, cy_norm)}" />
    <xacro:property name="ry" value="${atan2(c21, c11) if cy_norm > 1e-9 else 0.0}" />

    <origin
      xyz="${(reflect_x * tx) if reflect_position else tx} ${(reflect_y * ty) if reflect_position else ty} ${(reflect_z * tz) if reflect_position else tz}"
      rpy="${rr} ${rp} ${ry}" />
  </xacro:macro>

  <!-- ============================================================= limit -->
  <xacro:macro name="hw_emit_limit" params="limit">
    <limit
      lower="${limit['lower']}"
      upper="${limit['upper']}"
      effort="${limit['effort']}"
      velocity="${limit['velocity']}" />
  </xacro:macro>

  <!-- ====================================================== 单个 visual -->
  <xacro:macro name="hw_emit_visual" params="name visual">
    <visual name="${name}">
      <xacro:hw_emit_origin origin="${visual['origin']}" />
      <geometry>
        <xacro:if value="${visual['geometry']['type'] == 'cylinder'}">
          <cylinder radius="${visual['geometry']['radius']}" length="${visual['geometry']['length']}" />
        </xacro:if>
        <xacro:if value="${visual['geometry']['type'] == 'mesh'}">
          <mesh filename="${hw_arm_pkg_url}/${visual['geometry']['filename']}"
                scale="${visual['geometry']['scale']['x']} ${visual['geometry']['scale']['y']} ${visual['geometry']['scale']['z']}" />
        </xacro:if>
      </geometry>
      <material name="${name}_material">
        <color rgba="${visual['color']['r'] if 'color' in visual else 0.752941176470588} ${visual['color']['g'] if 'color' in visual else 0.752941176470588} ${visual['color']['b'] if 'color' in visual else 0.752941176470588} ${visual['color']['a'] if 'color' in visual else 1.0}" />
      </material>
    </visual>
  </xacro:macro>

  <!-- =================================================== 单个 collision -->
  <xacro:macro name="hw_emit_collision" params="name collision">
    <collision name="${name}">
      <xacro:hw_emit_origin origin="${collision['origin']}" />
      <geometry>
        <xacro:if value="${collision['geometry']['type'] == 'cylinder'}">
          <cylinder radius="${collision['geometry']['radius']}" length="${collision['geometry']['length']}" />
        </xacro:if>
        <xacro:if value="${collision['geometry']['type'] == 'mesh'}">
          <mesh filename="${hw_arm_pkg_url}/${collision['geometry']['filename']}"
                scale="${collision['geometry']['scale']['x']} ${collision['geometry']['scale']['y']} ${collision['geometry']['scale']['z']}" />
        </xacro:if>
      </geometry>
    </collision>
  </xacro:macro>

  <!-- ==================================================== 单个 inertial -->
  <xacro:macro name="hw_emit_inertial" params="inertial">
    <inertial>
      <xacro:hw_emit_origin origin="${inertial['origin']}" />
      <mass value="${inertial['mass']}" />
      <inertia
        ixx="${inertial['inertia']['xx']}"
        ixy="${inertial['inertia']['xy']}"
        ixz="${inertial['inertia']['xz']}"
        iyy="${inertial['inertia']['yy']}"
        iyz="${inertial['inertia']['yz']}"
        izz="${inertial['inertia']['zz']}" />
    </inertial>
  </xacro:macro>

  <!-- ======================================= 列表递归：N 个 visual
       visual 名优先用数据里的 name 字段（body / housing / flange），
       没有 name 时退回 <link>_visual<index>，保证向后兼容。 -->
  <xacro:macro name="hw_emit_visuals" params="link_name items index:=0">
    <xacro:if value="${index &lt; len(items)}">
      <xacro:property name="v_item" value="${items[index]}" />
      <xacro:property name="v_name" value="${(link_name + '_' + v_item['name']) if 'name' in v_item else (link_name + '_visual' + str(index))}" />
      <xacro:hw_emit_visual name="${v_name}" visual="${v_item}" />
      <xacro:hw_emit_visuals link_name="${link_name}" items="${items}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>

  <!-- ===================================== 列表递归：N 个 collision
       同样支持 name 字段；凸分解后会有多个碰撞块（collision_0 / collision_1 ...）。 -->
  <xacro:macro name="hw_emit_collisions" params="link_name items index:=0">
    <xacro:if value="${index &lt; len(items)}">
      <xacro:property name="c_item" value="${items[index]}" />
      <xacro:property name="c_name" value="${(link_name + '_' + c_item['name']) if 'name' in c_item else (link_name + '_collision' + str(index))}" />
      <xacro:hw_emit_collision name="${c_name}" collision="${c_item}" />
      <xacro:hw_emit_collisions link_name="${link_name}" items="${items}" index="${index + 1}" />
    </xacro:if>
  </xacro:macro>

  <!-- =============================================================== link -->
  <xacro:macro name="hw_emit_link" params="link_name source_name visuals collisions inertials">
    <link name="${link_name}">
      <xacro:if value="${source_name in visuals}">
        <xacro:hw_emit_visuals link_name="${link_name}" items="${visuals[source_name]}" />
      </xacro:if>
      <xacro:if value="${source_name in collisions}">
        <xacro:hw_emit_collisions link_name="${link_name}" items="${collisions[source_name]}" />
      </xacro:if>
      <xacro:if value="${source_name in inertials}">
        <xacro:hw_emit_inertial inertial="${inertials[source_name]}" />
      </xacro:if>
    </link>
  </xacro:macro>

  <!-- ===================================================== reference link -->
  <xacro:macro name="hw_emit_reference_link" params="link_name parent_link origin">
    <link name="${link_name}" />
    <joint name="${link_name}_joint" type="fixed">
      <xacro:hw_emit_origin origin="${origin}" />
      <parent link="${parent_link}" />
      <child link="${link_name}" />
    </joint>
  </xacro:macro>

  <!-- ============================================================== joint -->
  <xacro:macro name="hw_emit_joint" params="joint_name joint_type parent_link child_link joint_origins joint_axes joint_limits source_name:=''">
    <xacro:property name="src" value="${source_name if source_name != '' else joint_name}" />
    <joint name="${joint_name}" type="${joint_type}">
      <xacro:hw_emit_origin origin="${joint_origins[src]['origin'] if src in joint_origins else dict(x=0.0, y=0.0, z=0.0, roll=0.0, pitch=0.0, yaw=0.0)}" />
      <parent link="${parent_link}" />
      <child link="${child_link}" />

      <xacro:if value="${joint_type != 'fixed'}">
        <axis xyz="${joint_axes[src]['axis']['x']} ${joint_axes[src]['axis']['y']} ${joint_axes[src]['axis']['z']}" />
        <xacro:if value="${src in joint_limits}">
          <xacro:hw_emit_limit limit="${joint_limits[src]['limit']}" />
        </xacro:if>
      </xacro:if>
    </joint>
  </xacro:macro>

</robot>
